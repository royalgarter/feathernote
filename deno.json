{
  "name": "feathernote-cli",
  "version": "0.1.0",
  "description": "Deno CLI for FeatherNote - edit notes via $EDITOR, sync to S3",
  "license": "MIT",
  "icon": "https://feathernote.app/icon-192.png",
  "type": "module",
  "imports": {
    "yaml": "npm:yaml@2.6.1",
    "@std/cli": "jsr:@std/cli@^1.0.0"
  },
  "tasks": {
    "run": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --allow-run src/main.ts",
    "dev": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --allow-run --watch src/main.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  }
}
