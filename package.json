{
  "name": "feathernote",
  "version": "0.2.0",
  "private": true,
  "exports": "./src/main.ts",
  "scripts": {
    "start": "node src/server.js",
    "version": "node src/server.js --version",
    "deno:run": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --allow-run src/main.ts",
    "deno:dev": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --allow-run --watch src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@deno/kv": "0.12.0",
    "@deno/kv-linux-x64-gnu": "0.12.0",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "firebase-admin": "^13.6.0",
    "marked": "13.0.0",
    "multer": "2.0.2"
  },
  "imports": {
    "yaml": "npm:yaml@2.6.1"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  }
}
