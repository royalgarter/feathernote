{
  "name": "FeatherNote",
  "short_name": "FeatherNote",
  "description": "Lightweight offline-first PWA Note with Markdown, S3 Sync, Share Target API",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#A0D2EB",
  "theme_color": "#AC47FF",
  "share_target": {
    "action": "/_share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/icons/ios/512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "note_taking": {
    "new_note_url": "/#new_note"
  },
  "shortcuts": [
    {
      "name": "New Note",
      "url": "/#new_note",
      "description": "Create new note"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "categories": [
    "personalization",
    "productivity",
    "utilities"
  ]
}